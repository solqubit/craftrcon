# CraftRCON HTTPS reverse proxy (Caddy) - generated by ./install.sh.
[Unit]
Description=CraftRCON HTTPS proxy (Caddy)
Documentation=https://caddyserver.com/docs/
After=network-online.target craftrcon.service
Wants=network-online.target

[Service]
Type=notify
User=@SVC_USER@
Group=@SVC_USER@
Environment=XDG_DATA_HOME=@CADDY_DATA@
Environment=XDG_CONFIG_HOME=@CADDY_DATA@/config
ExecStart=@CADDY_BIN@ run --environ --config @CADDYFILE@ --adapter caddyfile
TimeoutStopSec=5s
LimitNOFILE=1048576
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@CADDY_DATA@
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
