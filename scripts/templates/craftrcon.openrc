#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034 # the variables are read by openrc-run
# CraftRCON panel - generated by ./install.sh; recreate it with the install menu
# ("repair service") instead of editing it by hand.

name="CraftRCON"
description="Minecraft RCON web panel"
supervisor="supervise-daemon"
command="@NODE_BIN@"
command_args="--disable-warning=ExperimentalWarning @APP_DIR@/src/server.js"
command_user="@SVC_USER@:@SVC_USER@"
directory="@APP_DIR@"
output_log="@LOG_FILE@"
error_log="@LOG_FILE@"
respawn_delay=3
export CRAFTRCON_CONFIG="@CONFIG_FILE@"
export NODE_ENV=production

depend() {
	need net
	after firewall
}

start_pre() {
	checkpath --file --mode 0640 --owner "@SVC_USER@:@SVC_USER@" "@LOG_FILE@"
}
