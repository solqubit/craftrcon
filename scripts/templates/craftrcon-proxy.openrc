#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034 # the variables are read by openrc-run
# CraftRCON HTTPS reverse proxy (Caddy) - generated by ./install.sh.

name="CraftRCON proxy"
description="HTTPS reverse proxy (Caddy) for the CraftRCON panel"
supervisor="supervise-daemon"
command="@CADDY_BIN@"
command_args="run --environ --config @CADDYFILE@ --adapter caddyfile"
command_user="@SVC_USER@:@SVC_USER@"
capabilities="^cap_net_bind_service"
output_log="@LOG_FILE@"
error_log="@LOG_FILE@"
respawn_delay=5
export XDG_DATA_HOME="@CADDY_DATA@"
export XDG_CONFIG_HOME="@CADDY_DATA@/config"

depend() {
	need net
	after firewall craftrcon
}

start_pre() {
	checkpath --file --mode 0640 --owner "@SVC_USER@:@SVC_USER@" "@LOG_FILE@"
}
