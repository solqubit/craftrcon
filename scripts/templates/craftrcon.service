# CraftRCON panel - generated by ./install.sh; recreate it with the install menu
# ("repair service") instead of editing it by hand.
[Unit]
Description=CraftRCON - Minecraft RCON web panel
Documentation=https://github.com/solqubit/craftrcon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SVC_USER@
Group=@SVC_USER@
Environment=CRAFTRCON_CONFIG=@CONFIG_FILE@
Environment=NODE_ENV=production
WorkingDirectory=@APP_DIR@
ExecStart=@NODE_BIN@ --disable-warning=ExperimentalWarning @APP_DIR@/src/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@DATA_DIR@
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
